# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Public account database and session signing key
MONGODB_URI=
MONGODB_DATABASE=reelcraft
GOOGLE_CLIENT_ID=
SESSION_SECRET=
BLOCKED_EMAIL_DOMAINS=

# Admin password must be a long, unique secret. Rotate any password previously
# pasted into chat before configuring this value.
ADMIN_EMAIL=iamhimanshugangwar@gmail.com
ADMIN_PASSWORD=

# Razorpay test/live credentials; keep the secret only in deployment secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary URL format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Render Free default is deliberately low; Admin Panel can set 1-10 minutes.
MAX_SOURCE_MINUTES=5

# Optional local-only model configuration (not used on Render)
OLLAMA_MODEL=qwen3.5:4b
