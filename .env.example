# Copy this file to ".env". It decides which AI picks the moments.

# --- Local model through Ollama: free, offline (default) ---
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
# Only needed if ollama isn't on your PATH or you keep models in a custom folder:
# OLLAMA_EXE=C:\path\to\ollama.exe
# OLLAMA_MODELS=D:\ollama-models

# --- Google Gemini: free tier, fast. Key: https://aistudio.google.com/apikey ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic Claude: paid ---
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=

# --- No AI: rule-based scoring ---
# AI_PROVIDER=none

# Whisper model for videos without YouTube captions: tiny, base, small, medium
# WHISPER_MODEL=small

# --- YouTube posting (optional) — see docs/youtube-setup.md ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
